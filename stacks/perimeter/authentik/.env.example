# PostgreSQL
PG_PASS=your-database-password

# Authentik
AUTHENTIK_SECRET_KEY=your-secret-key
AUTHENTIK_IMAGE=ghcr.io/goauthentik/server
AUTHENTIK_TAG=2026.5.3
# Hash of the akadmin bootstrap password; keep the plaintext in bws.
# Generate with: docker compose run --rm server hash_password '<your-bootstrap-password>'
# Must stay single-quoted: the hash contains literal $ characters
AUTHENTIK_BOOTSTRAP_PASSWORD_HASH='$argon2id$...'
AUTHENTIK_BOOTSTRAP_TOKEN=your-bootstrap-token
AUTHENTIK_BOOTSTRAP_EMAIL=your-bootstrap-email
